# Docker ignore file for BCN Art Compass
# Excludes unnecessary files from Docker build context

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Storage (build fresh in container)
storage/

# Git
.git/
.gitignore
.gitattributes

# Documentation
docs/
*.md
!README.md

# CI/CD
.github/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Scripts (not needed in container)
scripts/

# Tests (not needed in production)
tests/

# Vertex AI Configuration for BCN Art Compass
#
# Add these environment variables to Cloud Run deployment

# Enable Vertex AI RAG
USE_VERTEX_RAG=true

# Vertex AI Index Endpoint (full resource name)
VERTEX_INDEX_ENDPOINT=projects/877857922566/locations/europe-southwest1/indexEndpoints/5092533239579410432

# Deployed Index ID (will be set after deployment completes)
# Run: ./scripts/check_vertex_status.sh to get the deployed index ID
# VERTEX_DEPLOYED_INDEX_ID=bcn_art_compass_XXXXXXXXXX

# Project and Region
GOOGLE_CLOUD_PROJECT=bcn-art-compass
GOOGLE_CLOUD_LOCATION=europe-southwest1
